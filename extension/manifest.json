{
  "manifest_version": 3,
  "name": "Classic Dictionary",
  "version": "1.0.0",
  "description": "Bring back Google's original dictionary on word lookups and hide AI answers on those searches.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "icons": {"16":"icons/16.png", "32":"icons/32.png", "48":"icons/48.png", "128":"icons/128.png"},
  "action": {
    "default_title": "Classic Dictionary",
    "default_icon": {"16":"icons/16.png", "32":"icons/32.png"},
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": [
      "https://www.google.com/*", "https://google.com/*",
      "https://www.google.co.uk/*", "https://www.google.ca/*",
      "https://www.google.com.au/*", "https://www.google.co.nz/*",
      "https://www.google.co.in/*", "https://www.google.ie/*",
      "https://www.google.co.za/*", "https://www.google.com.sg/*",
      "https://www.google.de/*", "https://www.google.fr/*"
    ],
    "js": ["core.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_start"
  }]
}
